;; ===========================================================================
;; S4 — THE PAINTING by ascending auction on the Gallery, settled by a third party
;;   winning bid 150: pco 0.75 | Indie Forge primary 10% 15 | royalty 10% 15 (alice)
;;   | gallery 10% 15 | alice 104.25  -> alice nets 119.25
;; ===========================================================================
(begin-tx "S4 offer: alice lists Dawn through the auction contract on the Gallery")
(env-hash (hash "ms-s4"))
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data { "gal": { "keys": ["7777777777777777777777777777777777777777777777777777777777777777"], "pred": "keys-all" } })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "gal": { "keys": ["7777777777777777777777777777777777777777777777777777777777777777"], "pred": "keys-all" }
  , "quote":
    { "fungible": coin, "price": 0.0
    , "seller-account": "k:1111111111111111111111111111111111111111111111111111111111111111"
    , "seller-guard": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
    , "venue-id": (nft.venue-registry.create-venue-id "Smart Pacts Gallery" (read-keyset 'gal))
    , "fee-account": "", "fee-guard": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
    , "fee-bps": 0, "buyer-share-bps": 0, "sale-contract": "nft.conventional-auction" } })
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111", "caps": [] } ])
(let* ((pols [nft.issuance-policy nft.royalty-policy nft.transfer-mode-policy])
       (dawn (nft.ledger.create-token-id { 'uri: "ipfs://art/dawn", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111"))
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111", "caps": [ (nft.ledger.OFFER dawn alice 1.0 0) ] } ])
  (nft.ledger.sale dawn alice 1.0 0)
  ;; start +100 s, end +1000 s, reserve 50, increment 10, settlement grace 500 s (seller-signed)
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111", "caps": [] } ])
  (nft.conventional-auction.create-auction (hash "ms-s4") dawn 1767225700 1767226600 50.0 10.0 500))
(commit-tx)

(begin-tx "S4 bids: bob 100, carol 150; bob's bid is refunded in full")
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-01-01T00:00:00Z") 200) })
(env-data
  { "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "carol": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" } })
(let* ((bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333")
       (escrow (nft.conventional-auction.bid-escrow-account (hash "ms-s4")))
       (bob-before (coin.get-balance bob)))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
              , "caps": [ (coin.TRANSFER bob escrow 100.0), (nft.conventional-auction.PLACE-BID (read-keyset 'bob)) ] } ])
  (nft.conventional-auction.place-bid (hash "ms-s4") bob (read-keyset 'bob) 100.0)
  (expect "bob's 100 is held in the bid escrow" [-100.0 100.0] [(- (coin.get-balance bob) bob-before) (coin.get-balance escrow)])
  (env-sigs [ { "key": "3333333333333333333333333333333333333333333333333333333333333333"
              , "caps": [ (coin.TRANSFER carol escrow 150.0), (nft.conventional-auction.PLACE-BID (read-keyset 'carol)) ] } ])
  (nft.conventional-auction.place-bid (hash "ms-s4") carol (read-keyset 'carol) 150.0)
  (expect "bob is refunded in full; only carol's 150 remains in escrow" [0.0 150.0] [(- (coin.get-balance bob) bob-before) (coin.get-balance escrow)]))
(commit-tx)

(begin-tx "S4 settlement: dan (a stranger) settles to carol; four legs reconcile")
(env-chain-data { "chain-id": "0", "block-time": (add-time (time "2026-01-01T00:00:00Z") 1100) })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "buyer": "k:3333333333333333333333333333333333333333333333333333333333333333"
  , "buyer-guard": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" }
  , "buyer_fungible_account": (nft.conventional-auction.bid-escrow-account (hash "ms-s4"))
  , "quoted_price": 150.0 })
(let* ((pols [nft.issuance-policy nft.royalty-policy nft.transfer-mode-policy])
       (dawn (nft.ledger.create-token-id { 'uri: "ipfs://art/dawn", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333")
       (bal (lambda (a:string) (try 0.0 (coin.get-balance a))))
       (accts ["k:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" "k:6666666666666666666666666666666666666666666666666666666666666666" alice
               "k:7777777777777777777777777777777777777777777777777777777777777777" carol])
       (before (map bal accts)))
  (env-sigs [ { "key": "4444444444444444444444444444444444444444444444444444444444444444"
              , "caps": [ (nft.ledger.BUY dawn alice carol 1.0 (hash "ms-s4"))
                        , (coin.TRANSFER (nft.conventional-auction.bid-escrow-account (hash "ms-s4"))
                            (nft.policy-manager.escrow-account (hash "ms-s4")) 150.0) ] } ])
  (continue-pact 1 false (hash "ms-s4"))
  (expect "carol owns Dawn" 1.0 (nft.ledger.get-balance dawn carol))
  (expect "legs: pco 0.75 | Indie Forge primary 15 | alice royalty 15 + proceeds 104.25 | gallery 15 | carol 0 (already paid at bid time)"
    [0.75 15.0 119.25 15.0 0.0]
    (zip (lambda (a:string b:decimal) (- (bal a) b)) accts before))
  (expect "both escrows are empty" [0.0 0.0]
    [(coin.get-balance (nft.conventional-auction.bid-escrow-account (hash "ms-s4"))) (coin.get-balance (nft.policy-manager.escrow-account (hash "ms-s4")))]))
(commit-tx)

