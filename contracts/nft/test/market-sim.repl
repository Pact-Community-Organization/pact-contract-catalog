  , "buyer-guard": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "buyer_fungible_account": "k:2222222222222222222222222222222222222222222222222222222222222222" })
(let* ((pols [nft.attributes-policy nft.issuance-policy nft.royalty-policy nft.transfer-mode-policy])
       (card (nft.ledger.create-token-id { 'uri: "ipfs://cards/set1", 'precision: 0, 'policies: pols, 'serial: "001" } (read-keyset 'studio)))
       (studio "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333")
       (bal (lambda (a:string) (try 0.0 (coin.get-balance a))))
       (accts ["k:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" studio "k:8888888888888888888888888888888888888888888888888888888888888888" bob])
       (before (map bal accts)))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
              , "caps": [ (nft.ledger.BUY card studio bob 1.0 (hash "ms-s7a"))
                        , (coin.TRANSFER bob (nft.policy-manager.escrow-account (hash "ms-s7a")) 40.0) ] } ])
  (continue-pact 1 false (hash "ms-s7a"))
  (expect "legs: pco 0.20 | studio royalty 2.00 + proceeds 36.60 | shop 1.20 | bob -40"
    [0.2 38.6 1.2 -40.0]
    (zip (lambda (a:string b:decimal) (- (bal a) b)) accts before))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222", "caps": [ (nft.ledger.TRANSFER card bob carol 1.0) ] } ])
  (expect-failure "a sale-only card cannot be handed over for free" "sale-only token: free transfer is disabled"
    (nft.ledger.transfer-create card bob carol (read-keyset 'carol) 1.0)))
(commit-tx)

(begin-tx "S7 relocation step 0: bob moves the card to chain 1 (same owner); its stats leave with it")
(env-hash (hash "ms-xc"))
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "carol": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" } })
(let* ((pols [nft.attributes-policy nft.issuance-policy nft.royalty-policy nft.transfer-mode-policy])
       (card (nft.ledger.create-token-id { 'uri: "ipfs://cards/set1", 'precision: 0, 'policies: pols, 'serial: "001" } (read-keyset 'studio)))
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333"))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
              , "caps": [ (nft.ledger.XTRANSFER card bob carol "1" 1.0), (nft.ledger.XTRANSFER card bob bob "1" 1.0) ] } ])
  (expect-failure "a sale-only card cannot change owner by relocating either" "cross-chain relocation only to the same owner"
    (nft.ledger.transfer-crosschain card bob carol (read-keyset 'carol) "1" 1.0))
  (nft.ledger.transfer-crosschain card bob bob (read-keyset 'bob) "1" 1.0)
  (expect "the card has left chain 0" 0.0 (nft.ledger.get-balance card bob)))
(commit-tx)

(begin-tx "S7 relocation step 1 on chain 1: the card arrives with atk/hp/level intact")
