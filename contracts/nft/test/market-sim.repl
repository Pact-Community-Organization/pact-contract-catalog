;; nft framework — MARKET SIMULATION: several workshops, galleries and stores
;; trading the emulated collectibles, every leg reconciled.
;;
;; The market: a fixed protocol leg (0.5% to the PCO), two WORKSHOPS where
;; creators publish (a primary rate on the creator's own sale, a resale rate
;; after), a GALLERY and a CARD SHOP where anyone lists (a listing rate copied
;; at offer time), a buyer-side SCOUT venue that earns a share of the listing
;; fee, and a GREEDY gallery whose rate does not fit. The scenarios:
;;   S1  first sale of a baseball card through the shop, bought via the scout  (6 legs)
;;   S2  resale on the gallery: resale rates; rate changes after creation/offer
;;       reach nobody already in flight
;;   S3  a gift (free trading mode)
;;   S4  a 1/1 painting sold by ascending auction on the gallery, settled by a
;;       third party; the outbid bidder is refunded
;;   S5  a music edition sold 10 copies at a time: the label-only primary list
;;   S6  a resale of 4 copies with the 3-way beneficiary split
;;   S7  a sale-only game card: no gifting, sells through the pact; relocates
;;       to chain 1 WITH its on-chain stats and resells there
;;   S8  a dutch auction through the shop
;;   S9  a listing withdrawn: the NFT comes back
;;   S10 the 100% rule refuses a venue that does not fit
;;   S11 a sale-only ticket resold through the shop, then redeemed
;;   S12 a sealed pack sold like any other NFT, gifted, then opened on a real
;;       drand beacon
;;   FINAL every coin ever funded is still there; every supply reconciles.
;; Every leg is asserted as a DELTA on the account inside the settling tx, so a
;; wrong cut anywhere goes RED at the sale that produced it.
;;
;; REPL TIER: one database plays both chains; SPV is devnet evidence.
;; Run: pact contracts/nft/test/market-sim.repl

(begin-tx "coin")
(load "../../registry/kip/fungible-v2/fungible-v2.pact")
(load "../../registry/kip/fungible-xchain-v1/fungible-xchain-v1.pact")
(load "../../registry/core/coin/coin-v6.pact")
(create-table coin.coin-table)
(commit-tx)

(begin-tx "deploy nft framework + sale contracts + pack engine")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "g": { "keys": ["9999999999999999999999999999999999999999999999999999999999999999"], "pred": "keys-all" }
  , "ns": "nft", "admin-ks": "nft.admin" })
(env-keys ["9999999999999999999999999999999999999999999999999999999999999999"])
(define-namespace "nft" (read-keyset 'g) (read-keyset 'g))
(namespace "nft")
(define-keyset "nft.admin" (read-keyset 'g))
(load "../interfaces/account-protocols.pact")
(load "../interfaces/token-policy.pact")
(load "../interfaces/poly-fungible.pact")
(load "../interfaces/ledger-iface.pact")
(load "../interfaces/sale.pact")
(load "../interfaces/beacon-verifier.pact")
(load "../core/util.pact")
(load "../core/venue-registry.pact")
(create-table nft.venue-registry.venues)
(load "../core/policy-manager.pact")
(create-table nft.policy-manager.ledgers)
(create-table nft.policy-manager.quotes)
(create-table nft.policy-manager.sale-contracts)
(create-table nft.policy-manager.params)
(create-table nft.policy-manager.creation-venues)
(create-table nft.policy-manager.quote-expiry)
(load "../core/ledger.pact")
(create-table nft.ledger.ledger-table)
(create-table nft.ledger.tokens)
(nft.policy-manager.init nft.ledger)
(load "../policies/royalty-policy.pact")
(create-table nft.royalty-policy.royalties)
(load "../policies/issuance-policy.pact")
(create-table nft.issuance-policy.issuance)
(load "../policies/transfer-mode-policy.pact")
(create-table nft.transfer-mode-policy.modes)
(load "../policies/attributes-policy.pact")
(create-table nft.attributes-policy.specs)
(create-table nft.attributes-policy.attributes)
(create-table nft.attributes-policy.attr-history)
(load "../sale/conventional-auction.pact")
(create-table nft.conventional-auction.auctions)
(nft.policy-manager.register-sale-contract nft.conventional-auction)
(load "../sale/dutch-auction.pact")
(create-table nft.dutch-auction.auctions)
(nft.policy-manager.register-sale-contract nft.dutch-auction)
(load "../core/drand-verifier.pact")
(load "../core/pack-engine.pact")
(create-table nft.pack-engine.verifiers)
(create-table nft.pack-engine.series-table)
(create-table nft.pack-engine.pool)
(create-table nft.pack-engine.requests)
(create-table nft.pack-engine.queues)
(nft.pack-engine.set-verifier nft.drand-verifier)
(commit-tx)

;; personas
;;   creators:   studio k:aaaa (cards, potions, packs)  alice k:1111 (painter)
;;               musician k:bbbb  label k:cccc  producer k:dddd  club k:eeee (tickets)
;;   collectors: bob k:2222  carol k:3333  dan k:4444
;;   venues:     Smart Pacts Workshop k:5555 (500/100/250)  Indie Forge k:6666 (1000/0/0)
;;               Smart Pacts Gallery k:7777 (listing 1000)  Card Shop k:8888 (listing 300)
;;               Scout k:abab (buyer-side)  Greedy Gallery k:cdcd (listing 9000)
;;   protocol:   PCO k:ffff
(begin-tx "fund the collectors: 2500 coin enter the economy, and nothing else ever will")
(env-data
  { "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "carol": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" }
  , "dan": { "keys": ["4444444444444444444444444444444444444444444444444444444444444444"], "pred": "keys-all" } })
(test-capability (coin.CREDIT "k:2222222222222222222222222222222222222222222222222222222222222222"))
(coin.credit "k:2222222222222222222222222222222222222222222222222222222222222222" (read-keyset 'bob) 1000.0)
(test-capability (coin.CREDIT "k:3333333333333333333333333333333333333333333333333333333333333333"))
(coin.credit "k:3333333333333333333333333333333333333333333333333333333333333333" (read-keyset 'carol) 1000.0)
(test-capability (coin.CREDIT "k:4444444444444444444444444444444444444444444444444444444444444444"))
(coin.credit "k:4444444444444444444444444444444444444444444444444444444444444444" (read-keyset 'dan) 500.0)
(commit-tx)

(begin-tx "governance: 0.5% protocol leg to the PCO")
(env-data { "pco": { "keys": ["ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"], "pred": "keys-all" } })
(env-keys ["9999999999999999999999999999999999999999999999999999999999999999"])
(nft.policy-manager.set-protocol-fee 50 "k:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" (read-keyset 'pco))
(expect "protocol 50 bps" 50 (nft.policy-manager.protocol-bps))
(commit-tx)

(begin-tx "six venues register, each owner signing for its own")
(env-data
  { "wsa": { "keys": ["5555555555555555555555555555555555555555555555555555555555555555"], "pred": "keys-all" }
  , "wsb": { "keys": ["6666666666666666666666666666666666666666666666666666666666666666"], "pred": "keys-all" }
  , "gal": { "keys": ["7777777777777777777777777777777777777777777777777777777777777777"], "pred": "keys-all" }
  , "shop": { "keys": ["8888888888888888888888888888888888888888888888888888888888888888"], "pred": "keys-all" }
  , "scout": { "keys": ["abababababababababababababababababababababababababababababababab"], "pred": "keys-all" }
  , "greedy": { "keys": ["cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"], "pred": "keys-all" } })
(env-keys ["5555555555555555555555555555555555555555555555555555555555555555"
           "6666666666666666666666666666666666666666666666666666666666666666"
           "7777777777777777777777777777777777777777777777777777777777777777"
           "8888888888888888888888888888888888888888888888888888888888888888"
           "abababababababababababababababababababababababababababababababab"
           "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"])
(nft.venue-registry.register-venue "Smart Pacts Workshop" (read-keyset 'wsa) "k:5555555555555555555555555555555555555555555555555555555555555555" (read-keyset 'wsa) 500 100 250)
(nft.venue-registry.register-venue "Indie Forge" (read-keyset 'wsb) "k:6666666666666666666666666666666666666666666666666666666666666666" (read-keyset 'wsb) 1000 0 0)
(nft.venue-registry.register-venue "Smart Pacts Gallery" (read-keyset 'gal) "k:7777777777777777777777777777777777777777777777777777777777777777" (read-keyset 'gal) 0 0 1000)
(nft.venue-registry.register-venue "Card Shop" (read-keyset 'shop) "k:8888888888888888888888888888888888888888888888888888888888888888" (read-keyset 'shop) 0 0 300)
(nft.venue-registry.register-venue "Scout" (read-keyset 'scout) "k:abababababababababababababababababababababababababababababababab" (read-keyset 'scout) 0 0 0)
(nft.venue-registry.register-venue "Greedy Gallery" (read-keyset 'greedy) "k:cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd" (read-keyset 'greedy) 0 0 9000)
(expect "the shop's rates are public" { 'primary-bps: 0, 'resale-bps: 0, 'listing-bps: 300 }
  (let ((v (nft.venue-registry.get-venue (nft.venue-registry.create-venue-id "Card Shop" (read-keyset 'shop)))))
    { 'primary-bps: (at 'primary-bps v), 'resale-bps: (at 'resale-bps v), 'listing-bps: (at 'listing-bps v) }))
(commit-tx)

