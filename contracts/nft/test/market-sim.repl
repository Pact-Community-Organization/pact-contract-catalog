       (ticket (nft.ledger.create-token-id { 'uri: "ipfs://club/show", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'club))))
  (nft.ledger.create-token ticket 0 "ipfs://club/show" pols "" (read-keyset 'club))
  (nft.ledger.mint ticket "k:2222222222222222222222222222222222222222222222222222222222222222" (read-keyset 'bob) 2.0))
