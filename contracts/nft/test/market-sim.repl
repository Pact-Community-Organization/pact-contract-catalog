    , "seller-guard": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" }
    , "venue-id": (nft.venue-registry.create-venue-id "Greedy Gallery" (read-keyset 'greedy))
    , "fee-account": "", "fee-guard": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" }
    , "fee-bps": 0, "buyer-share-bps": 0, "sale-contract": "" } })
(let* ((pols [nft.issuance-policy nft.royalty-policy nft.transfer-mode-policy])
       (dawn (nft.ledger.create-token-id { 'uri: "ipfs://art/dawn", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333"))
  (env-sigs [ { "key": "3333333333333333333333333333333333333333333333333333333333333333", "caps": [ (nft.ledger.OFFER dawn carol 1.0 0) ] } ])
  (expect-failure "a 90% listing fee on top of 20.5% committed does not fit in 100%" "exceeds the headroom"
    (nft.ledger.sale dawn carol 1.0 0))
  (expect "carol keeps Dawn" 1.0 (nft.ledger.get-balance dawn carol)))
(rollback-tx)

;; ===========================================================================
;; S11 — THE TICKET: resold through the shop (the only way), then redeemed
;;   price 15: pco 0.075 | shop 3% 0.45 | bob 14.475
;; ===========================================================================
(begin-tx "S11 offer: bob resells one ticket on the Card Shop at 15")
(env-hash (hash "ms-s11"))
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data { "shop": { "keys": ["8888888888888888888888888888888888888888888888888888888888888888"], "pred": "keys-all" } })
(env-data
  { "club": { "keys": ["eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"], "pred": "keys-all" }
  , "shop": { "keys": ["8888888888888888888888888888888888888888888888888888888888888888"], "pred": "keys-all" }
  , "quote":
    { "fungible": coin, "price": 15.0
    , "seller-account": "k:2222222222222222222222222222222222222222222222222222222222222222"
    , "seller-guard": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
    , "venue-id": (nft.venue-registry.create-venue-id "Card Shop" (read-keyset 'shop))
    , "fee-account": "", "fee-guard": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
    , "fee-bps": 0, "buyer-share-bps": 0, "sale-contract": "" } })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (ticket (nft.ledger.create-token-id { 'uri: "ipfs://club/show", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'club)))
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222"))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222", "caps": [ (nft.ledger.OFFER ticket bob 1.0 0) ] } ])
  (nft.ledger.sale ticket bob 1.0 0))
(commit-tx)

(begin-tx "S11 buy + redeem: carol buys the ticket and burns it at the door")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "club": { "keys": ["eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"], "pred": "keys-all" }
  , "buyer": "k:3333333333333333333333333333333333333333333333333333333333333333"
  , "buyer-guard": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" }
  , "buyer_fungible_account": "k:3333333333333333333333333333333333333333333333333333333333333333" })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (ticket (nft.ledger.create-token-id { 'uri: "ipfs://club/show", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'club)))
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333")
       (bal (lambda (a:string) (try 0.0 (coin.get-balance a))))
       (accts ["k:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" "k:8888888888888888888888888888888888888888888888888888888888888888" bob carol])
       (before (map bal accts)))
  (env-sigs [ { "key": "3333333333333333333333333333333333333333333333333333333333333333"
              , "caps": [ (nft.ledger.BUY ticket bob carol 1.0 (hash "ms-s11"))
                        , (coin.TRANSFER carol (nft.policy-manager.escrow-account (hash "ms-s11")) 15.0) ] } ])
  (continue-pact 1 false (hash "ms-s11"))
  (expect "legs: pco 0.075 | shop 0.45 | bob 14.475 | carol -15"
    [0.075 0.45 14.475 -15.0]
    (zip (lambda (a:string b:decimal) (- (bal a) b)) accts before))
  (expect "carol holds the ticket" 1.0 (nft.ledger.get-balance ticket carol)))
(commit-tx)

(begin-tx "S11 redeem: carol burns her ticket at the door")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data { "club": { "keys": ["eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"], "pred": "keys-all" } })
(env-sigs [ { "key": "3333333333333333333333333333333333333333333333333333333333333333", "caps": [] } ])
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (ticket (nft.ledger.create-token-id { 'uri: "ipfs://club/show", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'club)))
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333"))
  (nft.ledger.burn ticket carol 1.0)
  (expect "the ticket is spent; bob keeps his other one; supply 1" [0.0 1.0 1.0]
    [(nft.ledger.get-balance ticket carol) (nft.ledger.get-balance ticket bob) (nft.ledger.total-supply ticket)]))
(commit-tx)

;; ===========================================================================
;; S12 — A SEALED PACK is just an NFT: sold on the shop, gifted, then opened
;;   price 12: pco 0.06 | shop 3% 0.36 | studio 11.58
;; ===========================================================================
(begin-tx "S12 offer: the studio lists a sealed pack on the Card Shop at 12")
(env-hash (hash "ms-s12"))
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data { "shop": { "keys": ["8888888888888888888888888888888888888888888888888888888888888888"], "pred": "keys-all" } })
(env-data
  { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
  , "shop": { "keys": ["8888888888888888888888888888888888888888888888888888888888888888"], "pred": "keys-all" }
  , "quote":
    { "fungible": coin, "price": 12.0
    , "seller-account": "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    , "seller-guard": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
    , "venue-id": (nft.venue-registry.create-venue-id "Card Shop" (read-keyset 'shop))
    , "fee-account": "", "fee-guard": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
    , "fee-bps": 0, "buyer-share-bps": 0, "sale-contract": "" } })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (pack (nft.ledger.create-token-id { 'uri: "ipfs://set1/pack", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'studio)))
       (studio "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
  (env-sigs [ { "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "caps": [ (nft.ledger.OFFER pack studio 1.0 0) ] } ])
  (nft.ledger.sale pack studio 1.0 0))
(commit-tx)

(begin-tx "S12 buy: bob buys the pack, then gives it to carol unopened")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
  , "carol": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" }
  , "buyer": "k:2222222222222222222222222222222222222222222222222222222222222222"
  , "buyer-guard": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "buyer_fungible_account": "k:2222222222222222222222222222222222222222222222222222222222222222" })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (pack (nft.ledger.create-token-id { 'uri: "ipfs://set1/pack", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'studio)))
       (studio "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333")
       (bal (lambda (a:string) (try 0.0 (coin.get-balance a))))
       (accts ["k:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" studio "k:8888888888888888888888888888888888888888888888888888888888888888" bob])
       (before (map bal accts)))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
              , "caps": [ (nft.ledger.BUY pack studio bob 1.0 (hash "ms-s12"))
                        , (coin.TRANSFER bob (nft.policy-manager.escrow-account (hash "ms-s12")) 12.0) ] } ])
  (continue-pact 1 false (hash "ms-s12"))
  (expect "legs: pco 0.06 | studio 11.58 | shop 0.36 | bob -12"
    [0.06 11.58 0.36 -12.0]
    (zip (lambda (a:string b:decimal) (- (bal a) b)) accts before))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222", "caps": [ (nft.ledger.TRANSFER pack bob carol 1.0) ] } ])
  (nft.ledger.transfer-create pack bob carol (read-keyset 'carol) 1.0)
  (expect "carol holds the sealed pack" 1.0 (nft.ledger.get-balance pack carol)))
(commit-tx)

(begin-tx "S12 open: carol requests an opening (the pack burns, a future beacon round is pinned)")
(env-chain-data { "chain-id": "0", "block-time": (add-time (nft.drand-verifier.time-of-round 20801766) -120.0) })
(env-hash (hash "ms-pack-open"))
(env-data { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" } })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (pack (nft.ledger.create-token-id { 'uri: "ipfs://set1/pack", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'studio)))
       (sid (nft.pack-engine.create-series-id "Set 1" (read-keyset 'studio)))
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333"))
  (env-sigs [ { "key": "3333333333333333333333333333333333333333333333333333333333333333", "caps": [] } ])
  (let ((rid (nft.pack-engine.request-open sid carol)))
    (expect "the pack is gone; supply 1 (the studio's unsold one)" [0.0 1.0] [(nft.ledger.get-balance pack carol) (nft.ledger.total-supply pack)])
    (expect "pinned to round 20801767" 20801767 (at 'round (nft.pack-engine.get-request rid)))))
(commit-tx)

(begin-tx "S12 reveal: anyone posts the real beacon; carol receives 3 cards, 1 of them rare")
(env-chain-data { "chain-id": "0", "block-time": (nft.drand-verifier.time-of-round 20801767) })
(env-data { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" } })
(env-sigs [])
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (mk (lambda (u:string) (nft.ledger.create-token-id { 'uri: u, 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'studio))))
       (a (mk "ipfs://set1/A")) (b (mk "ipfs://set1/B")) (x (mk "ipfs://set1/X"))
       (sid (nft.pack-engine.create-series-id "Set 1" (read-keyset 'studio)))
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333")
       (bal (lambda (t:string acct:string) (try 0.0 (nft.ledger.get-balance t acct)))))
  (nft.pack-engine.reveal sid 20801767 "0d745db068db9e16379a49f65d76353d721d79fb459d20b33a50e750e5cdb10400af36e03d4a8414b3a86770d1d1e90e85462dce40b3cf5c27f9fdb477b6f6e0")
  (expect "carol received exactly 3 cards, exactly 1 rare" [3.0 1.0]
    [(fold (+) 0.0 (map (lambda (t:string) (bal t carol)) [a b x])) (bal x carol)])
  (expect "3 cards remain in the vault for the last pack" 3.0
    (fold (+) 0.0 (map (lambda (t:string) (bal t (nft.pack-engine.vault-account sid))) [a b x]))))
(commit-tx)

;; ===========================================================================
;; FINAL RECONCILIATION
;; ===========================================================================
(begin-tx "every coin funded is still in the economy; every supply reconciles")
(env-chain-data { "chain-id": "0" })
(env-data
  { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
  , "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "musician": { "keys": ["bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"], "pred": "keys-all" }
  , "club": { "keys": ["eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"], "pred": "keys-all" } })
(let* ((bal (lambda (a:string) (try 0.0 (coin.get-balance a))))
       (people [ "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" "k:1111111111111111111111111111111111111111111111111111111111111111"
                 "k:2222222222222222222222222222222222222222222222222222222222222222" "k:3333333333333333333333333333333333333333333333333333333333333333"
                 "k:4444444444444444444444444444444444444444444444444444444444444444" "k:5555555555555555555555555555555555555555555555555555555555555555"
                 "k:6666666666666666666666666666666666666666666666666666666666666666" "k:7777777777777777777777777777777777777777777777777777777777777777"
                 "k:8888888888888888888888888888888888888888888888888888888888888888" "k:abababababababababababababababababababababababababababababababab"
                 "k:cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd" "k:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
                 "k:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" "k:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
                 "k:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" "k:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" ])
       (sales ["ms-s1" "ms-s2" "ms-s4" "ms-s5" "ms-s6" "ms-s7a" "ms-s7b" "ms-s8" "ms-s9" "ms-s11" "ms-s12"])
       (escrows (+ (map (lambda (s:string) (nft.policy-manager.escrow-account (hash s))) sales)
                   [(nft.conventional-auction.bid-escrow-account (hash "ms-s4"))]))
       (sum (lambda (xs:[decimal]) (fold (+) 0.0 xs))))
  (expect "no escrow holds a single coin" 0.0 (sum (map bal escrows)))
  (expect "the 2500 coin funded are exactly the coin held by the 16 participants" 2500.0 (sum (map bal people)))
  (expect "the protocol collected 0.5% of every sale: 20+50+150+30+8+40+60+28+15+12 = 413 -> 2.065" 2.065
    (bal "k:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))
  (expect "the collectors' spend equals everyone else's income" true
    (= (- 2500.0 (sum (map bal (take 3 (drop 2 people)))))
       (sum (map bal (+ (take 2 people) (drop 5 people))))))
  ;; supplies
  (let* ((p3 [nft.issuance-policy nft.royalty-policy nft.transfer-mode-policy])
         (p2 [nft.issuance-policy nft.transfer-mode-policy])
         (ace (nft.ledger.create-token-id { 'uri: "ipfs://baseball/2026/ace-rivera", 'precision: 0, 'policies: p3, 'serial: "2026" } (read-keyset 'studio)))
         (dawn (nft.ledger.create-token-id { 'uri: "ipfs://art/dawn", 'precision: 0, 'policies: p3, 'serial: "" } (read-keyset 'alice)))
         (track (nft.ledger.create-token-id { 'uri: "ipfs://music/track-01", 'precision: 0, 'policies: p3, 'serial: "" } (read-keyset 'musician)))
         (ticket (nft.ledger.create-token-id { 'uri: "ipfs://club/show", 'precision: 0, 'policies: p2, 'serial: "" } (read-keyset 'club)))
         (pack (nft.ledger.create-token-id { 'uri: "ipfs://set1/pack", 'precision: 0, 'policies: p2, 'serial: "" } (read-keyset 'studio))))
    (expect "supplies: Ace 10 | Dawn 1 | Track 100 | tickets 1 (2 issued, 1 redeemed) | packs 1 (2 sealed, 1 opened)"
      [10.0 1.0 100.0 1.0 1.0]
      (map (lambda (t:string) (nft.ledger.total-supply t)) [ace dawn track ticket pack]))
    (expect "Ace holders: studio 7, dan 2, bob 0, carol 0, escrow 0 -> 9 in wallets + 1 unsold copy still with the studio = 10" 10.0
      (fold (+) 0.0 (map (lambda (a:string) (try 0.0 (nft.ledger.get-balance ace a)))
        ["k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" "k:2222222222222222222222222222222222222222222222222222222222222222"
         "k:3333333333333333333333333333333333333333333333333333333333333333" "k:4444444444444444444444444444444444444444444444444444444444444444"])))
    (expect "Track holders: musician 90, dan 6, bob 4" [90.0 6.0 4.0]
      (map (lambda (a:string) (nft.ledger.get-balance track a))
        ["k:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" "k:4444444444444444444444444444444444444444444444444444444444444444" "k:2222222222222222222222222222222222222222222222222222222222222222"]))))
(commit-tx)

(print "")
(print "=== MARKET SIMULATION: ALL GREEN ===")
(print "  2 workshops, 2 listing venues, a buyer-side scout, a greedy venue refused; 11 settlements")
(print "  (fixed price, ascending + dutch auctions, lots of 10 and 4, a chain-1 resale, a pack);")
(print "  every leg asserted as a delta; a gift, a withdrawal, a redemption, a pack opened on a")
(print "  real drand beacon; 2500 coin in, 2500 coin accounted for.")
