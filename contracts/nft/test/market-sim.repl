(begin-tx "the studio publishes 'Ace Rivera' (edition of 10, 3% royalty) through the Smart Pacts Workshop")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data { "wsa": { "keys": ["5555555555555555555555555555555555555555555555555555555555555555"], "pred": "keys-all" } })
(env-data
  { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
  , "wsa": { "keys": ["5555555555555555555555555555555555555555555555555555555555555555"], "pred": "keys-all" }
  , "creation_venue": (nft.venue-registry.create-venue-id "Smart Pacts Workshop" (read-keyset 'wsa))
  , "issuance_spec": { "max-issued": 10.0, "min-mint": 1.0 }
  , "transfer_mode": "free"
  , "royalty_spec":
    { "beneficiaries": [ { "account": "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                         , "guard": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
                         , "bps": 300, "label": "studio" } ]
    , "primary": [] } })
(env-sigs [ { "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "caps": [] } ])
(let* ((pols [nft.issuance-policy nft.royalty-policy nft.transfer-mode-policy])
       (ace (nft.ledger.create-token-id { 'uri: "ipfs://baseball/2026/ace-rivera", 'precision: 0, 'policies: pols, 'serial: "2026" } (read-keyset 'studio)))
       (studio "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
  (nft.ledger.create-token ace 0 "ipfs://baseball/2026/ace-rivera" pols "2026" (read-keyset 'studio))
  (expect "the Workshop's rates at creation are copied into the card for good" { 'primary-bps: 500, 'resale-bps: 100 }
    (let ((cv (nft.policy-manager.get-creation-venue ace))) { 'primary-bps: (at 'primary-bps cv), 'resale-bps: (at 'resale-bps cv) }))
  (nft.ledger.mint ace studio (read-keyset 'studio) 10.0))
(commit-tx)

