;; The game card is self-published (no creation venue) ON PURPOSE: the
;; creation-venue record lives on the creating chain only, so a workshop's
;; resale leg is NOT collected after a relocation on real chains (gap F2,
;; recorded in nft-ops). One REPL database would mask that; this card keeps
;; the chain-1 resale identical on both tiers.
(begin-tx "the studio publishes game card #001: on-chain stats, 5% royalty, SALE-ONLY trading")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
  , "issuance_spec": { "max-issued": 1.0, "min-mint": 1.0 }
  , "transfer_mode": "sale-only"
  , "royalty_spec":
    { "beneficiaries": [ { "account": "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                         , "guard": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
                         , "bps": 500, "label": "studio" } ]
    , "primary": [] }
  , "attributes_spec":
    { "writers":
      [ { "key": "atk",   "guard": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" } }
      , { "key": "hp",    "guard": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" } }
      , { "key": "level", "guard": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" } } ]
    , "max-value-bytes": 16, "history": "events", "holder-freeze": false } })
(env-sigs [ { "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "caps": [] } ])
(let* ((pols [nft.attributes-policy nft.issuance-policy nft.royalty-policy nft.transfer-mode-policy])
       (card (nft.ledger.create-token-id { 'uri: "ipfs://cards/set1", 'precision: 0, 'policies: pols, 'serial: "001" } (read-keyset 'studio)))
       (studio "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
  (nft.ledger.create-token card 0 "ipfs://cards/set1" pols "001" (read-keyset 'studio))
  (nft.attributes-policy.set-attribute card "atk" "52")
  (nft.attributes-policy.set-attribute card "hp" "39")
  (nft.attributes-policy.set-attribute card "level" "1")
  (nft.ledger.mint card studio (read-keyset 'studio) 1.0))
(commit-tx)

