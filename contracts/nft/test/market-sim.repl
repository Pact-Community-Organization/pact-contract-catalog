(begin-tx "the studio seals 'Set 1': 2 packs x 3 cards from a vault of 6")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
  , "issuance_spec": { "max-issued": 2.0, "min-mint": 1.0 }
  , "transfer_mode": "free" })
(env-sigs [ { "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "caps": [] } ])
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (mk (lambda (u:string) (nft.ledger.create-token-id { 'uri: u, 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'studio))))
       (pack (mk "ipfs://set1/pack")) (a (mk "ipfs://set1/A")) (b (mk "ipfs://set1/B")) (x (mk "ipfs://set1/X"))
       (slots [ { 'name: "common", 'picks: 2, 'tiers: ["C"] }, { 'name: "rare", 'picks: 1, 'tiers: ["R"] } ]))
  (map (lambda (u:string) (nft.ledger.create-token (mk u) 0 u pols "" (read-keyset 'studio))) ["ipfs://set1/pack" "ipfs://set1/A" "ipfs://set1/B" "ipfs://set1/X"])
  (let ((sid (nft.pack-engine.create-series "Set 1" (read-keyset 'studio) pack 3 2 slots)))
    (nft.pack-engine.add-pool-card sid a "C" 2)
    (nft.pack-engine.add-pool-card sid b "C" 2)
    (nft.pack-engine.add-pool-card sid x "R" 2)
    (nft.pack-engine.lock-series sid)
    (nft.pack-engine.mint-pool sid [a b x])
    (nft.pack-engine.seal-series sid)
    (expect "the studio holds 2 sealed packs" 2.0 (nft.ledger.get-balance pack "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))))
(commit-tx)

;; ===========================================================================
;; S1 — FIRST SALE through the Card Shop, bought via the Scout
;;   price 20: pco 0.10 | workshop primary 5% 1.00 | royalty 3% 0.60 (studio)
;;   | shop 3% 0.60 of which 1% 0.20 to the scout | seller 17.70
;; ===========================================================================
(begin-tx "S1 offer: the studio lists one Ace Rivera on the Card Shop at 20")
(env-hash (hash "ms-s1"))
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data { "shop": { "keys": ["8888888888888888888888888888888888888888888888888888888888888888"], "pred": "keys-all" } })
(env-data
  { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
  , "shop": { "keys": ["8888888888888888888888888888888888888888888888888888888888888888"], "pred": "keys-all" }
  , "quote":
    { "fungible": coin, "price": 20.0
    , "seller-account": "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    , "seller-guard": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
    , "venue-id": (nft.venue-registry.create-venue-id "Card Shop" (read-keyset 'shop))
    , "fee-account": "", "fee-guard": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
    , "fee-bps": 0, "buyer-share-bps": 100, "sale-contract": "" } })
(let* ((pols [nft.issuance-policy nft.royalty-policy nft.transfer-mode-policy])
       (ace (nft.ledger.create-token-id { 'uri: "ipfs://baseball/2026/ace-rivera", 'precision: 0, 'policies: pols, 'serial: "2026" } (read-keyset 'studio)))
       (studio "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
  (env-sigs [ { "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "caps": [ (nft.ledger.OFFER ace studio 1.0 0) ] } ])
  (nft.ledger.sale ace studio 1.0 0)
  (expect "the shop's registry rate was copied into the quote" { 'fee-bps: 300, 'fee-account: "k:8888888888888888888888888888888888888888888888888888888888888888" }
    (let ((q (nft.policy-manager.get-quote (hash "ms-s1")))) { 'fee-bps: (at 'fee-bps q), 'fee-account: (at 'fee-account q) }))
  (expect "the card sits in escrow, not with the seller" 9.0 (nft.ledger.get-balance ace studio)))
(commit-tx)

(begin-tx "S1 buy: bob buys through the Scout; six legs reconcile")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data { "scout": { "keys": ["abababababababababababababababababababababababababababababababab"], "pred": "keys-all" } })
(env-data
  { "studio": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" }
  , "scout": { "keys": ["abababababababababababababababababababababababababababababababab"], "pred": "keys-all" }
  , "buyer": "k:2222222222222222222222222222222222222222222222222222222222222222"
  , "buyer-guard": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "buyer_fungible_account": "k:2222222222222222222222222222222222222222222222222222222222222222"
  , "buyer_venue_id": (nft.venue-registry.create-venue-id "Scout" (read-keyset 'scout)) })
(let* ((pols [nft.issuance-policy nft.royalty-policy nft.transfer-mode-policy])
       (ace (nft.ledger.create-token-id { 'uri: "ipfs://baseball/2026/ace-rivera", 'precision: 0, 'policies: pols, 'serial: "2026" } (read-keyset 'studio)))
       (studio "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (bal (lambda (a:string) (try 0.0 (coin.get-balance a))))
       (accts ["k:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" "k:5555555555555555555555555555555555555555555555555555555555555555" studio
               "k:8888888888888888888888888888888888888888888888888888888888888888" "k:abababababababababababababababababababababababababababababababab" bob])
       (before (map bal accts)))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
              , "caps": [ (nft.ledger.BUY ace studio bob 1.0 (hash "ms-s1"))
                        , (coin.TRANSFER bob (nft.policy-manager.escrow-account (hash "ms-s1")) 20.0) ] } ])
  (continue-pact 1 false (hash "ms-s1"))
  (expect "bob holds his Ace" 1.0 (nft.ledger.get-balance ace bob))
  (expect "legs: pco 0.10 | workshop 1.00 | studio 0.60 + 17.70 | shop 0.40 | scout 0.20 | bob -20"
    [0.1 1.0 18.3 0.4 0.2 -20.0]
    (zip (lambda (a:string b:decimal) (- (bal a) b)) accts before))
  (expect "the settlement escrow is empty" 0.0 (coin.get-balance (nft.policy-manager.escrow-account (hash "ms-s1")))))
(commit-tx)

