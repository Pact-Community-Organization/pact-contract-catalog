;; nft framework — swap suite (ADR-NFT-014): NFT-for-NFT exchange.
;;
;; Proves:
;;   * an offer escrows exactly the offered copies under a guard only the module
;;     can satisfy; the offerer's authorization is the ledger transfer they sign;
;;   * validation: same token both sides, zero amounts, a venue without a fee and a
;;     fee without a venue, an unknown wanted token, a reserved taker;
;;   * accept: anyone (or only the reserved taker); the taker must hold the wanted
;;     copies and pay the flat fees (protocol + venue) in coin; both tokens change
;;     hands in one transaction; the escrow empties; an offer takes once;
;;   * cancel: offerer only, open offers only, the escrow returns;
;;   * the escrow cannot be debited outside accept/cancel;
;;   * sale-only and bound tokens cannot be offered (the ledger's transfer path
;;     refuses them, policies included) — barter is for free-trading tokens;
;;   * the fee is governance-set, principal-checked, and zero means no transfer.
;; Each expect goes RED if the mechanism it names is removed.
;;
;; Run: pact contracts/nft/test/swap.repl

(begin-tx "coin")
(load "../../registry/kip/fungible-v2/fungible-v2.pact")
(load "../../registry/kip/fungible-xchain-v1/fungible-xchain-v1.pact")
(load "../../registry/core/coin/coin-v6.pact")
(create-table coin.coin-table)
(commit-tx)

(begin-tx "deploy nft framework + swap")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "g": { "keys": ["9999999999999999999999999999999999999999999999999999999999999999"], "pred": "keys-all" }
  , "ns": "nft", "admin-ks": "nft.admin" })
(env-keys ["9999999999999999999999999999999999999999999999999999999999999999"])
(define-namespace "nft" (read-keyset 'g) (read-keyset 'g))
(namespace "nft")
(define-keyset "nft.admin" (read-keyset 'g))
(load "../interfaces/account-protocols.pact")
(load "../interfaces/token-policy.pact")
(load "../interfaces/poly-fungible.pact")
(load "../interfaces/ledger-iface.pact")
(load "../interfaces/sale.pact")
(load "../core/util.pact")
(load "../core/venue-registry.pact")
(create-table nft.venue-registry.venues)
(load "../core/policy-manager.pact")
(create-table nft.policy-manager.ledgers)
(create-table nft.policy-manager.quotes)
(create-table nft.policy-manager.sale-contracts)
(create-table nft.policy-manager.params)
(create-table nft.policy-manager.creation-venues)
(load "../core/ledger.pact")
(create-table nft.ledger.ledger-table)
(create-table nft.ledger.tokens)
(nft.policy-manager.init nft.ledger)
(load "../policies/issuance-policy.pact")
(create-table nft.issuance-policy.issuance)
(load "../policies/transfer-mode-policy.pact")
(create-table nft.transfer-mode-policy.modes)
(load "../core/swap.pact")
(create-table nft.swap.offers)
(create-table nft.swap.params)
(commit-tx)

;; personas: alice k:1111 (gives A), bob k:2222 (holds B, takes), carol k:3333 (stranger),
;; venue owner k:5555 ("Swap Shop"), pco k:7777 (protocol fee payee)
(begin-tx "fund bob and carol; register the Swap Shop")
(env-data
  { "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "carol": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" }
  , "shop": { "keys": ["5555555555555555555555555555555555555555555555555555555555555555"], "pred": "keys-all" } })
(test-capability (coin.CREDIT "k:2222222222222222222222222222222222222222222222222222222222222222"))
(coin.credit "k:2222222222222222222222222222222222222222222222222222222222222222" (read-keyset 'bob) 100.0)
(test-capability (coin.CREDIT "k:3333333333333333333333333333333333333333333333333333333333333333"))
(coin.credit "k:3333333333333333333333333333333333333333333333333333333333333333" (read-keyset 'carol) 100.0)
(env-keys ["5555555555555555555555555555555555555555555555555555555555555555"])
(nft.venue-registry.register-venue "Swap Shop" (read-keyset 'shop) "k:5555555555555555555555555555555555555555555555555555555555555555" (read-keyset 'shop) 0 0 300)
(commit-tx)

;; ---------------------------------------------------------------------------
;; the flat protocol fee: governance only, principal payee, zero allowed
;; ---------------------------------------------------------------------------
(begin-tx "swap fee: governance only, principal-checked")
(env-data { "pco": { "keys": ["7777777777777777777777777777777777777777777777777777777777777777"], "pred": "keys-all" } })
(env-keys [])
(expect-failure "a stranger cannot set the swap fee" "Keyset failure"
  (nft.swap.set-swap-fee 0.5 "k:7777777777777777777777777777777777777777777777777777777777777777" (read-keyset 'pco)))
(env-keys ["9999999999999999999999999999999999999999999999999999999999999999"])
(expect-failure "a negative fee is refused" "must not be negative"
  (nft.swap.set-swap-fee -1.0 "k:7777777777777777777777777777777777777777777777777777777777777777" (read-keyset 'pco)))
(expect-failure "the payee must be the principal of its guard" "principal"
  (nft.swap.set-swap-fee 0.5 "k:1234" (read-keyset 'pco)))
(expect "fee unset reads 0" 0.0 (at 'fee (nft.swap.get-swap-fee)))
(expect "governance sets 0.5 coin to the protocol account" true
  (nft.swap.set-swap-fee 0.5 "k:7777777777777777777777777777777777777777777777777777777777777777" (read-keyset 'pco)))
(expect "fee reads 0.5" 0.5 (at 'fee (nft.swap.get-swap-fee)))
(commit-tx)

;; ---------------------------------------------------------------------------
;; the tokens: A (alice, free, 3 copies), B (bob, free, 2 copies),
;; S (alice, sale-only), D (bob, bound)
;; ---------------------------------------------------------------------------
(begin-tx "create the tokens")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "issuance_spec": { "max-issued": 3.0, "min-mint": 1.0 }
  , "transfer_mode": "free" })
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111", "caps": [] }
          , { "key": "2222222222222222222222222222222222222222222222222222222222222222", "caps": [] } ])
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (a (nft.ledger.create-token-id { 'uri: "ipfs://A", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (b (nft.ledger.create-token-id { 'uri: "ipfs://B", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob))))
  (nft.ledger.create-token a 0 "ipfs://A" pols "" (read-keyset 'alice))
  (nft.ledger.mint a alice (read-keyset 'alice) 3.0)
  (nft.ledger.create-token b 0 "ipfs://B" pols "" (read-keyset 'bob))
  (nft.ledger.mint b bob (read-keyset 'bob) 2.0))
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "issuance_spec": { "max-issued": 3.0, "min-mint": 1.0 }
  , "transfer_mode": "sale-only" })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (s (nft.ledger.create-token-id { 'uri: "ipfs://S", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice))))
  (nft.ledger.create-token s 0 "ipfs://S" pols "" (read-keyset 'alice))
  (nft.ledger.mint s alice (read-keyset 'alice) 1.0))
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "issuance_spec": { "max-issued": 3.0, "min-mint": 1.0 }
  , "transfer_mode": "bound" })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (d (nft.ledger.create-token-id { 'uri: "ipfs://D", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob))))
  (nft.ledger.create-token d 0 "ipfs://D" pols "" (read-keyset 'bob))
  (nft.ledger.mint d bob (read-keyset 'bob) 1.0))
(commit-tx)

;; ---------------------------------------------------------------------------
;; offer validation
;; ---------------------------------------------------------------------------
(begin-tx "offer: validation")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "shop": { "keys": ["5555555555555555555555555555555555555555555555555555555555555555"], "pred": "keys-all" } })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (a (nft.ledger.create-token-id { 'uri: "ipfs://A", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (b (nft.ledger.create-token-id { 'uri: "ipfs://B", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob)))
       (shop-id (nft.venue-registry.create-venue-id "Swap Shop" (read-keyset 'shop))))
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
              , "caps": [ (nft.ledger.TRANSFER a alice (nft.swap.escrow-account (nft.swap.create-offer-id alice a [b] "n1")) 1.0) ] } ])
  (expect-failure "cannot want the token being given" "cannot want the token being given"
    (nft.swap.offer "n1" alice a 1.0 [a] 1.0 "" "" 0.0))
  (expect-failure "give-amount must be positive" "give-amount must be positive"
    (nft.swap.offer "n1" alice a 0.0 [b] 1.0 "" "" 0.0))
  (expect-failure "want-amount must be positive" "want-amount must be positive"
    (nft.swap.offer "n1" alice a 1.0 [b] 0.0 "" "" 0.0))
  (expect-failure "a venue needs a positive fee" "a named venue needs a positive venue-fee"
    (nft.swap.offer "n1" alice a 1.0 [b] 1.0 "" shop-id 0.0))
  (expect-failure "a fee needs a venue" "a venue-fee needs a venue"
    (nft.swap.offer "n1" alice a 1.0 [b] 1.0 "" "" 1.0))
  (expect-failure "an unknown venue is refused" "No value found"
    (nft.swap.offer "n1" alice a 1.0 [b] 1.0 "" "v:nope" 1.0))
  (expect-failure "an unknown wanted token is refused" "No value found"
    (nft.swap.offer "n1" alice a 1.0 ["n:nope"] 1.0 "" "" 0.0))
  (expect-failure "an empty wanted list is refused" "want-ids must name 1 to"
    (nft.swap.offer "n1" alice a 1.0 [] 1.0 "" "" 0.0))
  (expect-failure "a wanted list with a repeat is refused" "want-ids must be distinct"
    (nft.swap.offer "n1" alice a 1.0 [b b] 1.0 "" "" 0.0))
  (expect-failure "a list longer than the bound is refused" "want-ids must name 1 to"
    (nft.swap.offer "n1" alice a 1.0 (make-list 17 b) 1.0 "" "" 0.0))
  (expect-failure "a reserved taker must be a principal account" "reserved taker must be a principal account"
    (nft.swap.offer "n1" alice a 1.0 [b] 1.0 "notakey" "" 0.0))
  (expect-failure "an offer without the offerer's transfer signature fails at the escrow" "Managed capability"
    (nft.swap.offer "n2" alice a 1.0 [b] 1.0 "" "" 0.0)))
(rollback-tx)

;; ---------------------------------------------------------------------------
;; offer A x1 for B x1 through the Swap Shop (venue fee 1 coin), anyone may take
;; ---------------------------------------------------------------------------
(begin-tx "alice offers 1 A for 1 B, venue fee 1 coin to the Swap Shop")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "shop": { "keys": ["5555555555555555555555555555555555555555555555555555555555555555"], "pred": "keys-all" } })
(env-events true)
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (a (nft.ledger.create-token-id { 'uri: "ipfs://A", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (b (nft.ledger.create-token-id { 'uri: "ipfs://B", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob)))
       (shop-id (nft.venue-registry.create-venue-id "Swap Shop" (read-keyset 'shop)))
       (oid (nft.swap.create-offer-id alice a [b] "n1"))
       (escrow (nft.swap.escrow-account oid)))
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
              , "caps": [ (nft.ledger.TRANSFER a alice escrow 1.0) ] } ])
  (expect "the offer id is derived" oid (nft.swap.offer "n1" alice a 1.0 [b] 1.0 "" shop-id 1.0))
  (expect "the escrow holds the offered copy" 1.0 (nft.ledger.get-balance a escrow))
  (expect "alice keeps 2" 2.0 (nft.ledger.get-balance a alice))
  (expect "the offer is open with the venue copied" { 'active: true, 'venue-account: "k:5555555555555555555555555555555555555555555555555555555555555555", 'venue-fee: 1.0 }
    (let ((o (nft.swap.get-offer oid))) { 'active: (at 'active o), 'venue-account: (at 'venue-account o), 'venue-fee: (at 'venue-fee o) }))
  (expect "SWAP-OFFERED event fired" 1
    (length (filter (lambda (e) (= "nft.swap.SWAP-OFFERED" (at 'name e))) (env-events true))))
  (expect-failure "the same nonce cannot be reused" "already found"
    (nft.swap.offer "n1" alice a 1.0 [b] 1.0 "" shop-id 1.0)))
(commit-tx)

(begin-tx "the escrow cannot be debited outside accept/cancel")
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" } })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (a (nft.ledger.create-token-id { 'uri: "ipfs://A", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (b (nft.ledger.create-token-id { 'uri: "ipfs://B", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob)))
       (escrow (nft.swap.escrow-account (nft.swap.create-offer-id alice a [b] "n1"))))
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
              , "caps": [ (nft.ledger.TRANSFER a escrow alice 1.0) ] } ])
  (expect-failure "the offerer cannot pull the escrow back by hand" "Capability"
    (nft.ledger.transfer-create a escrow alice (read-keyset 'alice) 1.0)))
(rollback-tx)

(begin-tx "take: refusals")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "carol": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" } })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333")
       (a (nft.ledger.create-token-id { 'uri: "ipfs://A", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (b (nft.ledger.create-token-id { 'uri: "ipfs://B", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob)))
       (oid (nft.swap.create-offer-id alice a [b] "n1")))
  (env-sigs [ { "key": "3333333333333333333333333333333333333333333333333333333333333333"
              , "caps": [ (coin.TRANSFER carol "k:7777777777777777777777777777777777777777777777777777777777777777" 0.5)
                        , (coin.TRANSFER carol "k:5555555555555555555555555555555555555555555555555555555555555555" 1.0) ] } ])
  (expect-failure "a taker who holds none of the wanted token cannot take" "No value found"
    (nft.swap.accept oid carol b))
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111", "caps": [] } ])
  (expect-failure "the offerer cannot take their own offer" "cannot accept their own offer"
    (nft.swap.accept oid alice b))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
              , "caps": [ (nft.ledger.TRANSFER b bob alice 1.0) ] } ])
  (expect-failure "a taker who does not sign the fee cannot take" "Managed capability"
    (nft.swap.accept oid bob b))
  (expect-failure "a stranger cannot cancel" "Keyset failure" (nft.swap.cancel oid)))
(rollback-tx)

(begin-tx "bob takes: both tokens change hands, both flat fees are paid")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" } })
(env-events true)
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (a (nft.ledger.create-token-id { 'uri: "ipfs://A", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (b (nft.ledger.create-token-id { 'uri: "ipfs://B", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob)))
       (oid (nft.swap.create-offer-id alice a [b] "n1"))
       (escrow (nft.swap.escrow-account oid)))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
              , "caps": [ (nft.ledger.TRANSFER b bob alice 1.0)
                        , (coin.TRANSFER bob "k:7777777777777777777777777777777777777777777777777777777777777777" 0.5)
                        , (coin.TRANSFER bob "k:5555555555555555555555555555555555555555555555555555555555555555" 1.0) ] } ])
  (expect "the exchange completes" true (nft.swap.accept oid bob b))
  (expect "alice received 1 B" 1.0 (nft.ledger.get-balance b alice))
  (expect "bob received 1 A" 1.0 (nft.ledger.get-balance a bob))
  (expect "bob keeps 1 B" 1.0 (nft.ledger.get-balance b bob))
  (expect "the escrow is empty" 0.0 (nft.ledger.get-balance a escrow))
  (expect "the protocol fee 0.5 reached the payee" 0.5 (coin.get-balance "k:7777777777777777777777777777777777777777777777777777777777777777"))
  (expect "the venue fee 1 reached the Swap Shop" 1.0 (coin.get-balance "k:5555555555555555555555555555555555555555555555555555555555555555"))
  (expect "bob paid exactly 1.5" 98.5 (coin.get-balance bob))
  (expect "the offer is closed and names the taker" { 'active: false, 'taken-by: bob }
    (let ((o (nft.swap.get-offer oid))) { 'active: (at 'active o), 'taken-by: (at 'taken-by o) }))
  (expect "SWAP-ACCEPTED + 2 SWAP-FEE events" 3
    (length (filter (lambda (e) (contains (at 'name e) ["nft.swap.SWAP-ACCEPTED" "nft.swap.SWAP-FEE"])) (env-events true))))
  (expect-failure "an offer takes once" "offer is not active" (nft.swap.accept oid bob b))
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111", "caps": [] } ])
  (expect-failure "a taken offer cannot be cancelled" "offer is not active" (nft.swap.cancel oid)))
(commit-tx)

;; ---------------------------------------------------------------------------
;; a reserved offer, zero protocol fee, and cancel
;; ---------------------------------------------------------------------------
(begin-tx "governance drops the protocol fee to 0")
(env-keys ["9999999999999999999999999999999999999999999999999999999999999999"])
(env-data { "pco": { "keys": ["7777777777777777777777777777777777777777777777777777777777777777"], "pred": "keys-all" } })
(nft.swap.set-swap-fee 0.0 "" (read-keyset 'pco))
(expect "fee reads 0" 0.0 (at 'fee (nft.swap.get-swap-fee)))
(commit-tx)

(begin-tx "alice offers 1 A for 1 B reserved for bob, no venue; carol cannot take; bob takes with no fee")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" } })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333")
       (a (nft.ledger.create-token-id { 'uri: "ipfs://A", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (b (nft.ledger.create-token-id { 'uri: "ipfs://B", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob)))
       (oid (nft.swap.create-offer-id alice a [b] "n2"))
       (escrow (nft.swap.escrow-account oid)))
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
              , "caps": [ (nft.ledger.TRANSFER a alice escrow 1.0) ] } ])
  (nft.swap.offer "n2" alice a 1.0 [b] 1.0 bob "" 0.0)
  (env-sigs [ { "key": "3333333333333333333333333333333333333333333333333333333333333333", "caps": [] } ])
  (expect-failure "carol cannot take an offer reserved for bob" "reserved for another taker"
    (nft.swap.accept oid carol b))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
              , "caps": [ (nft.ledger.TRANSFER b bob alice 1.0) ] } ])
  (expect "bob takes with no coin signature: no fee is due" true (nft.swap.accept oid bob b))
  (expect "alice now holds 2 B, bob 2 A" [2.0 2.0] [(nft.ledger.get-balance b alice) (nft.ledger.get-balance a bob)])
  (expect "bob paid nothing" 98.5 (coin.get-balance bob)))
(commit-tx)

(begin-tx "any of these: alice offers 1 A for 1 B OR 1 C; carol accepts with C; a token outside the list is refused")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" }
  , "carol": { "keys": ["3333333333333333333333333333333333333333333333333333333333333333"], "pred": "keys-all" }
  , "issuance_spec": { "max-issued": 3.0, "min-mint": 1.0 }
  , "transfer_mode": "free" })
(env-sigs [ { "key": "3333333333333333333333333333333333333333333333333333333333333333", "caps": [] } ])
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (carol "k:3333333333333333333333333333333333333333333333333333333333333333")
       (a (nft.ledger.create-token-id { 'uri: "ipfs://A", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (b (nft.ledger.create-token-id { 'uri: "ipfs://B", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob)))
       (c (nft.ledger.create-token-id { 'uri: "ipfs://C", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'carol)))
       (oid (nft.swap.create-offer-id bob a [b c] "any1"))
       (escrow (nft.swap.escrow-account oid)))
  (nft.ledger.create-token c 0 "ipfs://C" pols "" (read-keyset 'carol))
  (nft.ledger.mint c carol (read-keyset 'carol) 1.0)
  ;; bob (who holds 2 A now) offers 1 A for 1 B or 1 C
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
              , "caps": [ (nft.ledger.TRANSFER a bob escrow 1.0) ] } ])
  (expect "the offer names two alternatives" [b c] (at 'want-ids (nft.swap.get-offer (nft.swap.offer "any1" bob a 1.0 [b c] 1.0 "" "" 0.0))))
  (env-sigs [ { "key": "3333333333333333333333333333333333333333333333333333333333333333"
              , "caps": [ (nft.ledger.TRANSFER c carol bob 1.0), (nft.ledger.TRANSFER a carol bob 1.0) ] } ])
  (expect-failure "a token outside the list is refused" "not one the offer wants"
    (nft.swap.accept oid carol a))
  (expect "carol accepts with C" true (nft.swap.accept oid carol c))
  (expect "bob received C, carol received A" [1.0 1.0] [(nft.ledger.get-balance c bob) (nft.ledger.get-balance a carol)]))
(commit-tx)

(begin-tx "cancel: offerer only, the escrow returns")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" } })
(env-events true)
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (a (nft.ledger.create-token-id { 'uri: "ipfs://A", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (b (nft.ledger.create-token-id { 'uri: "ipfs://B", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob)))
       (oid (nft.swap.create-offer-id alice a [b] "n3"))
       (escrow (nft.swap.escrow-account oid)))
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
              , "caps": [ (nft.ledger.TRANSFER a alice escrow 1.0) ] } ])
  (nft.swap.offer "n3" alice a 1.0 [b] 1.0 "" "" 0.0)
  (expect "alice has 0 A left in her wallet" 0.0 (nft.ledger.get-balance a alice))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222", "caps": [] } ])
  (expect-failure "bob cannot cancel alice's offer" "Keyset failure" (nft.swap.cancel oid))
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111", "caps": [] } ])
  (expect "alice cancels" true (nft.swap.cancel oid))
  (expect "the copy is back with alice; the escrow is empty" [1.0 0.0] [(nft.ledger.get-balance a alice) (nft.ledger.get-balance a escrow)])
  (expect "SWAP-CANCELLED event fired" 1
    (length (filter (lambda (e) (= "nft.swap.SWAP-CANCELLED" (at 'name e))) (env-events true))))
  (expect-failure "a cancelled offer cannot be taken" "offer is not active" (nft.swap.accept oid "k:2222222222222222222222222222222222222222222222222222222222222222" b)))
(commit-tx)

;; ---------------------------------------------------------------------------
;; barter is for free-trading tokens: sale-only and bound cannot be offered
;; ---------------------------------------------------------------------------
(begin-tx "a sale-only token and a bound token cannot be offered")
(env-chain-data { "chain-id": "0", "block-time": (time "2026-01-01T00:00:00Z") })
(env-data
  { "alice": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "bob": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" } })
(let* ((pols [nft.issuance-policy nft.transfer-mode-policy])
       (alice "k:1111111111111111111111111111111111111111111111111111111111111111")
       (bob "k:2222222222222222222222222222222222222222222222222222222222222222")
       (b (nft.ledger.create-token-id { 'uri: "ipfs://B", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob)))
       (s (nft.ledger.create-token-id { 'uri: "ipfs://S", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'alice)))
       (d (nft.ledger.create-token-id { 'uri: "ipfs://D", 'precision: 0, 'policies: pols, 'serial: "" } (read-keyset 'bob))))
  (env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
              , "caps": [ (nft.ledger.TRANSFER s alice (nft.swap.escrow-account (nft.swap.create-offer-id alice s [b] "n4")) 1.0) ] } ])
  (expect-failure "a sale-only token cannot be bartered" "sale-only token: free transfer is disabled"
    (nft.swap.offer "n4" alice s 1.0 [b] 1.0 "" "" 0.0))
  (env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
              , "caps": [ (nft.ledger.TRANSFER d bob (nft.swap.escrow-account (nft.swap.create-offer-id bob d [b] "n5")) 1.0) ] } ])
  (expect-failure "a bound token cannot be bartered" "bound token: free transfer is disabled"
    (nft.swap.offer "n5" bob d 1.0 [b] 1.0 "" "" 0.0)))
(rollback-tx)

(begin-tx "direct capability acquisition is refused")
(expect-failure "ESCROW is not acquirable from outside" "not granted"
  (require-capability (nft.swap.ESCROW "x:any")))
(rollback-tx)

(print "")
(print "=== SWAP: ALL GREEN ===")
(print "  escrowed offers released only by take or cancel; reserved takers; flat protocol + venue fees")
(print "  paid by the taker; one take per offer; barter refused for sale-only and bound tokens.")
